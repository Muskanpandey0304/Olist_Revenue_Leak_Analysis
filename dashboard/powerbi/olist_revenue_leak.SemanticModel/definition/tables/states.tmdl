table states

	column state_code
		dataType: string
		sourceColumn: state_code
		summarizeBy: none

	column state_name
		dataType: string
		sourceColumn: state_name
		summarizeBy: none

	column region
		dataType: string
		sourceColumn: region
		summarizeBy: none

	column population
		dataType: int64
		formatString: #,##0
		sourceColumn: population
		summarizeBy: none

	column income_pc
		dataType: int64
		formatString: \R\$#,##0
		sourceColumn: income_pc
		summarizeBy: none

	column revenue
		dataType: double
		formatString: \R\$#,##0
		sourceColumn: revenue
		summarizeBy: none

	column orders
		dataType: int64
		sourceColumn: orders
		summarizeBy: none

	column rev_per_1000
		dataType: double
		formatString: \R\$#,##0.0
		sourceColumn: rev_per_1000
		summarizeBy: none

	column expected_rev_per_1000
		dataType: double
		formatString: \R\$#,##0.0
		sourceColumn: expected_rev_per_1000
		summarizeBy: none

	column penetration_vs_expected
		dataType: double
		formatString: 0.00
		sourceColumn: penetration_vs_expected
		summarizeBy: none

	column avg_freight_ratio
		dataType: double
		formatString: 0.0
		sourceColumn: avg_freight_ratio
		summarizeBy: none

	column late_pct
		dataType: double
		formatString: 0.0
		sourceColumn: late_pct
		summarizeBy: none

	column avg_delivery_days
		dataType: double
		formatString: 0.0
		sourceColumn: avg_delivery_days
		summarizeBy: none

	partition states = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataPath), true, true),
				    Sheet = Source{[Item="states", Kind="Sheet"]}[Data],
				    Typed = Table.TransformColumnTypes(Sheet, {{"state_code", type text}, {"state_name", type text}, {"region", type text}, {"population", Int64.Type}, {"income_pc", Int64.Type}, {"revenue", type number}, {"orders", Int64.Type}, {"rev_per_1000", type number}, {"expected_rev_per_1000", type number}, {"penetration_vs_expected", type number}, {"avg_freight_ratio", type number}, {"late_pct", type number}, {"avg_delivery_days", type number}})
				in
				    Typed
