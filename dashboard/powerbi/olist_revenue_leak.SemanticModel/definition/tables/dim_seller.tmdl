table dim_seller

	column seller_id
		dataType: string
		sourceColumn: seller_id
		summarizeBy: none

	column city
		dataType: string
		sourceColumn: city
		summarizeBy: none

	column state
		dataType: string
		sourceColumn: state
		summarizeBy: none

	column region
		dataType: string
		sourceColumn: region
		summarizeBy: none

	partition dim_seller = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataPath), true, true),
				    Sheet = Source{[Item="dim_seller", Kind="Sheet"]}[Data],
				    Typed = Table.TransformColumnTypes(Sheet, {{"seller_id", type text}, {"city", type text}, {"state", type text}, {"region", type text}})
				in
				    Typed
