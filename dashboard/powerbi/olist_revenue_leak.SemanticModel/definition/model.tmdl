model Model
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures

	annotation __PBI_TimeIntelligenceEnabled = 0
	annotation PBI_QueryOrder = ["DataPath", "dim_date", "dim_customer", "dim_seller", "dim_product", "fact_orders", "fact_order_items", "rfm_segments", "states", "seller_watchlist"]

ref table dim_date
ref table dim_customer
ref table dim_seller
ref table dim_product
ref table fact_orders
ref table fact_order_items
ref table rfm_segments
ref table states
ref table seller_watchlist
ref expression DataPath
